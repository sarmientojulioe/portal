[Unit]
Description=App Certificaciones (Streamlit frontend)
After=network.target

[Service]
Type=simple
# El frontend Streamlit vive en frontend/; el venv en la raíz del repo.
WorkingDirectory=/root/certificaciones/frontend
ExecStart=/root/certificaciones/.venv/bin/streamlit run app.py \
  --server.address=127.0.0.1 --server.port=8504 --server.baseUrlPath=certificaciones
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
