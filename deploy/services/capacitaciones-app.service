[Unit]
Description=App Capacitaciones - CapacitaApp (Streamlit frontend)
After=network.target

[Service]
Type=simple
# Frontend Streamlit. REQUIERE el backend FastAPI corriendo (ver deploy/README).
WorkingDirectory=/root/capacitaciones/frontend
ExecStart=/root/capacitaciones/.venv/bin/streamlit run app.py \
  --server.address=127.0.0.1 --server.port=8507 --server.baseUrlPath=capacitaciones
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
