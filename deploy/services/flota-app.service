[Unit]
Description=App Control de Flota (Streamlit)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/flota
ExecStart=/root/flota/.venv/bin/streamlit run app.py \
  --server.address=127.0.0.1 --server.port=8503 --server.baseUrlPath=flota
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
