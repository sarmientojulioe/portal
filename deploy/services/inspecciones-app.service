[Unit]
Description=App Inspecciones (Streamlit)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/inspecciones/inspecciones_american
ExecStart=/root/inspecciones/.venv/bin/streamlit run app.py \
  --server.address=127.0.0.1 --server.port=8505 --server.baseUrlPath=inspecciones
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
